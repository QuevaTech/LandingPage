  "trng_copy": "Kopyala",
  "trng_api_eyebrow": "Geliştirici API",
  "trng_api_title": "REST API Endpoint'leri",
  "trng_api_subtitle": "TRNG servislerine programatik erişim. Tüm endpoint'ler CORS etkin, rate-limited ve API key korumalı.",
  "trng_api_entropy_desc": "Ham entropi baytları veya işlenmiş rastgele değerler alın. Hex, Base64 veya raw formatında.",
  "trng_api_password_desc": "Güvenli, rastgele parolalar üretin. Özel karakter seti ve uzunluk parametreleri desteklenir.",
  "trng_api_health_desc": "Sistem sağlığı, NIST test sonuçları, aktarım hızı ve uptime metrikleri.",
