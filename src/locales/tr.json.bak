  "pub_mlops_desc": "Üretim düzeyi makine öğrenmesi boru hatlarının (MLOps), donanım tabanlı güvenlik sistemlerine entegrasyonu üzerine teknik bir inceleme. Kubernetes ve Kubeflow ekosisteminin ölçeklenebilir altyapı çalışmalarındaki rolü.",
  "pub_ds_title": "Fiziksel Entropi ve Rastgelelik Analizi",
  "pub_ds_desc": "Fiziksel entropi kaynaklarının yapay zeka ile hibritlenmesi, gerçek rastgele sayı üretimi (TRNG) süreçlerinde yeni bir paradigma sunmaktadır. QuevaTech'in hibrit yaklaşımı, entropi kalitesi ve öngörülemezlik üzerindeki etkileriyle analiz edilmektedir.",
  "trng_demo_eyebrow": "Canlı Demo · TRNG",
  "trng_demo_title": "TRNG Canlı Demo ve API Playground",
  "trng_demo_subtitle": "Gerçek zamanlı entropi görselleştirmesi, NIST sağlık kontrolü ve kriptografik anahtar/parola üretimi. QuevaTech AI-Hybrid TRNG teknolojisinin canlı performansını deneyimleyin.",
  "trng_status_connected": "Bağlı",
  "trng_status_disconnected": "Bağlantı Kesildi",
  "trng_throughput": "Aktarım Hızı",
  "trng_live_entropy": "Canlı Entropi Akışı",
  "trng_entropy_title": "Gerçek Zamanlı Entropi Görselleştirmesi",
  "trng_entropy_subtitle": "Kuantum gürültüsü ve termal entropi kaynaklarından gelen ham verinin anlık entropi kalitesi. 1M örnek/saniye hızında güncellenir.",
  "trng_entropy_bits": "Entropi Bitleri",
  "trng_samples_sec": "Örnek/Saniye",
  "trng_buffer": "Tampon Doluluk",
  "trng_health_eyebrow": "Sistem Sağlığı",
  "trng_health_title": "NIST SP 800-90B Sağlık Kontrolü",
  "trng_health_subtitle": "15 NIST istatistiksel testinin anlık durumu. Tüm testler geçmeli (PASS) kriptografik kullanım için.",
  "trng_last_update": "Son Güncelleme",
  "trng_entropy_rate": "Entropi Oranı",
  "trng_nist_passed": "NIST Geçen",
  "trng_uptime": "Çalışma Süresi",
  "trng_nist_tests": "NIST Testleri",
  "trng_generator_eyebrow": "Üretici Araçları",
  "trng_generator_title": "Kriptografik Üretici",
  "trng_generator_subtitle": "Gerçek rastgelelik kaynaklı anahtar ve parola üretimi. Tarayıcıda Web Crypto API ile güvenli üretim.",
  "trng_key_gen": "Anahtar Üretici",
  "trng_key_length": "Anahtar Uzunluğu",
  "trng_generate_key": "Anahtar Üret",
  "trng_generated_key": "Üretilen Anahtar (Hex)",
  "trng_password_gen": "Parola Üretici",
