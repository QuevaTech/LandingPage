  "trng_specs_title": "TRNG Teknik Özellikleri",
  "trng_specs_subtitle": "QuevaTech AI-Hybrid TRNG mimarisi: fiziksel entropi + ML tabanlı kalite kontrol.",
  "trng_spec_entropy": "Entropi Kaynağı",
  "trng_spec_entropy_desc": "Kuantum gürültüsü (shot noise) + termal gürültü (Johnson-Nyquist). FPGA tabanlı ADC ile dijitalleştirme.",
  "trng_spec_throughput": "Aktarım Hızı",
  "trng_spec_throughput_desc": "10-15 MB/s ham entropi. İşlenmiş çıktı: 1-5 MB/s (NIST post-processing sonrası).",
  "trng_spec_nist": "NIST Uyumluluğu",
  "trng_spec_nist_desc": "SP 800-90A/B/C tam uyumlu. 15/15 test sürekli PASS. Entropi kaybı < 0.1%.",
  "trng_spec_crypto": "Kriptografik Güvenlik",
  "trng_spec_crypto_desc": "AES-256-CTR DRBG (SP 800-90A). Forward/backtracking resistance. Tampon doluluk %99+.",
